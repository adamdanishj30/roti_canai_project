rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only the listed family accounts can read or change anything.
    // - Exact email match (no domain wildcard), so nobody can sign up a
    //   lookalike address.
    // - The email must be verified, and the login must come from Google
    //   sign-in. Email/password accounts are rejected, so a guessed or
    //   leaked password is useless, and Google's 2-step verification
    //   protects the account.
    // Keep this list the same as ALLOWED_EMAILS in orders.html.
    function isFamilyMember() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'roticanai@gmail.com'
          // Add more family Google accounts here later.
        ];
    }

    // 1. Orders: customer names, phone numbers and addresses.
    match /orders/{orderId} {
      allow read, write: if isFamilyMember();
    }

    // 2. Inventory logs: stock recounts and production records.
    match /inventory_logs/{logId} {
      allow read, write: if isFamilyMember();
    }

    // 3. Everything else is blocked.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
