rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: only the listed family accounts are granted access.
    // Exact email match only (no domain wildcard), so nobody can sign up
    // a lookalike address to read customer orders.
    function isFamilyMember() {
      return request.auth != null
        && request.auth.token.email in [
          'roticanai@gmail.com'
          // Add more family accounts here later.
        ];
    }

    // 1. Orders Collection: Contains customer names, phone numbers, and addresses.
    // Strictly restricted to authenticated family members.
    match /orders/{orderId} {
      allow read, write: if isFamilyMember();
    }

    // 2. Inventory Logs Collection: Contains stock recounts and production records.
    match /inventory_logs/{logId} {
      allow read, write: if isFamilyMember();
    }

    // 3. Fallback: Block all other documents by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
